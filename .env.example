# demo uses fictional fixtures. live calls the providers below and never fills gaps with demo data.
APP_DATA_MODE=demo

# The Odds API. Server-side only. Used for NBA events and player props.
# https://the-odds-api.com/liveapi/guides/v4/
THE_ODDS_API_KEY=
ODDS_REGIONS=us
# Preferred bookmaker key. If that book is absent, the first book in the response is used.
ODDS_BOOKMAKER_PREFERENCE=draftkings
ODDS_CACHE_TTL_SECONDS=60

# BallDontLie NBA API. Server-side only. Game logs and the injury list.
# Implemented from https://www.balldontlie.io/openapi/nba.yml
# Paths: /nba/v1/players, /nba/v1/stats, /nba/v1/player_injuries
# Authorization header is the raw key, not a Bearer token.
BALLDONTLIE_API_KEY=
STATS_CACHE_TTL_SECONDS=600

# Language model. Optional. Prices and logs are still calculated in code.
# Free tier: create a key at https://console.groq.com and set GROQ_API_KEY.
# Paid alternative: set OPENAI_API_KEY. If both are set, OpenAI is used.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cost and abuse limits. The chat limit is per server instance, not global.
# The games board lists every event in the window. Props are loaded for the selected game.
SLATE_EVENT_LIMIT=8
LOOKUP_EVENT_LIMIT=12
CANDIDATE_PLAYER_CAP=18
CHAT_REQUESTS_PER_MINUTE=20
